<section class="page-header">
    <div class="container">
        <span class="section-label">About Me</span>
        <hr class="section-divider" />
    </div>
</section>


<section class="py-5">
    <div class="container">
        <div class="row g-5">

            <div class="col-lg-4 text-center">
                <div class="about-photo">
                    <%= image_tag "IMG_2553.jpg", alt: "cat picture" %>
                </div>
            </div>

            <div class="col-lg-8">
                <p class="text-secondary">
                    I’m an Analytics Engineer who loves turning complex data into clear, traceable insights. After
                    three years at National Australia Bank monitoring various data protection tools for Group
