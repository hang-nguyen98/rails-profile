<!DOCTYPE html>
<html>
    <head>
        <title><%= content_for(:title) || "Rails Profile" %></title>
        <meta name="viewport" content="width=device-width,initial-scale=1">
        <%= csrf_meta_tags %>
        <%= csp_meta_tag %>
        <%= yield :head %>
        <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
        <%# Add javascript_importmap_tags to include JavaScript files in the application layout %>
        <%= javascript_importmap_tags %>
    </head>
    <body>
        <!-- Navbar 
        Appears at the top of all pages -->
        <nav class="navbar navbar-expand-lg navbar-custom fixed-top">
            <div class="container">
                <a class="navbar-brand" href="<%= home_path %>">HN.</a>
                <!-- hamburger button, visible on small screens  
                    - data-bs-toggle="collapse" and data-bs-target="#mainNav" toggle div with id="mainNav" when clicked 
                -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <!-- collapsible menu, holds the nav links
                    - "collapse navbar-collapse" hides this div on small screens and shows it when the
                        hamburger button is clicked
                    - "ms-auto" pushes the nav links to the right
                    -->
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" href="<%= home_path %>">
                                <i class="fa-solid fa-house fa-sm me-1"></i>Home</a></li>
                        <li class="nav-item"><a class="nav-link" href="<%= about_path %>">
                                <i class="fa-solid fa-user fa-sm me-1"></i>About</a></li>
                        <li class="nav-item"><a class="nav-link" href="<%= portfolio_path %>">
                                <i class="fa-solid fa-code fa-sm me-1"></i>Projects</a></li>
                        <li class="nav-item"><a class="nav-link" href="<%= experience_path %>">
                                <i class="fa-solid fa-briefcase fa-sm me-1"></i>Experience</a></li>
                        <li class="nav-item"><a class="nav-link" href="<%= contact_path %>">
                                <i class="fa-solid fa-envelope fa-sm me-1"></i>Contact</a></li>
                    </ul>
                </div>
            </div>
        </nav>
        
            <%= yield %>
        

        <!-- Footer 
        Appears at the bottom of all pages -->
        <footer class="footer-custom">
            <div class="container">
                <div class="row align-items-center">
                    <!-- Responsiveness for footer and its subtext -->
                    <div class="col-md-6">
                        <!-- Custom CSS class for name -->
                        <div class="footer-name">Hang Nguyen</div>
                        <p class="small text-secondary mb-0">Analytics Engineer, Security</p>
                    </div>
                    <!-- Responsive footer social media links
                    Align social media icons to the right -->
                    <div class="col-md-6 text-md-end">
                        <div class="footer-social">
                            <a href="https://www.linkedin.com/in/hang-t-nguyen98/" target="_blank" rel="noopener"
                                title="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
                            <a href="https://github.com/hang-nguyen98" target="_blank" rel="noopener" title="GitHub"><i
                                    class="fa-brands fa-github"></i></a>
                            <a href="mailto:htnguyen.0610@gmail.com" title="Email"><i class="fa-solid fa-envelope"></i></a>
                        </div>
                    </div>
                </div>
                <p class="small text-secondary text-center mt-4 mb-0">
                    &copy; 2026 Hang Nguyen. All rights reserved.
                </p>
            </div>
        </footer>
    </body>
</html>
